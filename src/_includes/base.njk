{%- set s = lab.settings -%}
{%- set p = lab.pages[navKey] or {} -%}
{%- set navLabel = "" -%}
{%- for item in navigation %}{% if item.key == navKey %}{% set navLabel = item.label %}{% endif %}{% endfor -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if pageTitle %}{{ pageTitle }} · {{ s.site_title }}{% elif navKey == "home" %}{{ s.site_title }}{% else %}{{ navLabel }} · {{ s.site_title }}{% endif %}</title>
  <meta name="description" content="{{ p.intro or p.lead or s.description }}">
  <meta property="og:title" content="{% if pageTitle %}{{ pageTitle }} · {{ s.site_title }}{% elif navKey == 'home' %}{{ s.site_title }}{% else %}{{ navLabel }} · {{ s.site_title }}{% endif %}">
  <meta property="og:description" content="{{ p.intro or p.lead or s.description }}">
  <meta property="og:image" content="{{ s.logo_round }}">
  <link rel="icon" type="image/png" href="{{ s.logo_round }}">
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/site.css">
  {%- if s.atlas_height %}
  <style>:root { --atlas-height: {{ s.atlas_height | int }}px; }</style>
  {%- endif %}
</head>
<body>

<header class="site-header" id="top">
  <div class="wrap">
    <a class="site-logo" href="/" aria-label="Home">
      <img src="{{ s.logo_header }}" alt="KU Leuven — Leuven Brain Institute — Neuropsychiatry">
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      Menu
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      {%- for item in navigation %}{% if not item.requires or lab.visible[item.requires] %}
      <a href="{{ item.url }}"{% if item.key == navKey %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endif %}{% endfor %}
    </nav>
  </div>
</header>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <img class="footer-badge" src="{{ s.logo_round }}" alt="Neuropsychiatry KU Leuven">
      <div class="footer-text">{{ s.footer_text }}</div>
    </div>
    <div class="footer-col">
      <div class="footer-col-title">Pages</div>
      {%- for item in navigation %}{% if item.key != "home" and (not item.requires or lab.visible[item.requires]) %}
      <a href="{{ item.url }}">{{ item.label }}</a>
      {%- endif %}{% endfor %}
    </div>
    <div class="footer-col">
      <div class="footer-col-title">Elsewhere</div>
      {%- for link in s.elsewhere %}
      <a href="{{ link.url }}">{{ link.label }}</a>
      {%- endfor %}
    </div>
  </div>
  <div class="footer-bottom">
    <div class="wrap">© {{ lab.year }} {{ s.copyright }}</div>
  </div>
</footer>

<script>
  // Spam-safe email links (see _includes/email.njk)
  (function () {
    function decode(e) {
      try { return decodeURIComponent(escape(atob(e))).split('').reverse().join(''); } catch (err) { return ''; }
    }
    document.querySelectorAll('.js-email').forEach(function (link) {
      link.addEventListener('click', function (ev) {
        var addr = decode(link.getAttribute('data-e'));
        if (!addr) return;
        if (link.getAttribute('data-mode') === 'open') {
          ev.preventDefault();
          window.location.href = 'mailto:' + addr;
          return;
        }
        if (!link.classList.contains('revealed')) {
          ev.preventDefault();
          link.textContent = addr;
          link.href = 'mailto:' + addr;
          link.classList.add('revealed');
        }
      });
    });
  })();
  // Copy buttons (Donate page)
  (function () {
    document.querySelectorAll('[data-copy]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var text = btn.getAttribute('data-copy');
        var done = function () { var t = btn.textContent; btn.textContent = 'Copied'; setTimeout(function () { btn.textContent = t; }, 1500); };
        if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, function () {});
      });
    });
  })();
  (function () {
    var header = document.querySelector('.site-header');
    var btn = document.querySelector('.nav-toggle');
    if (!header || !btn) return;
    btn.addEventListener('click', function () {
      var open = header.classList.toggle('nav-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  })();
</script>
</body>
</html>
