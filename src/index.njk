---
layout: base.njk
navKey: home
permalink: /
---
{%- set p = lab.pages.home -%}
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      {% if p.eyebrow %}<div class="eyebrow">{{ p.eyebrow }}</div>{% endif %}
      <h1>{{ p.title }}</h1>
      {% if p.intro %}<p>{{ p.intro }}</p>{% endif %}
      <div class="btn-row">
        {% if p.primary_button %}<a class="btn btn-primary" href="/research/">{{ p.primary_button }}</a>{% endif %}
        {% if p.secondary_button %}<a class="btn btn-secondary" href="/people/">{{ p.secondary_button }}</a>{% endif %}
      </div>
    </div>
    <img class="hero-badge" src="{{ lab.settings.logo_round }}" alt="Neuropsychiatry KU Leuven">
  </div>
</section>

{% if p.group_photo %}
<section class="wrap atlas-section">
  <figure class="group-photo">
    <img src="{{ p.group_photo }}" alt="{{ p.group_photo_alt or 'The research group' }}">
    {% if p.group_photo_caption %}<figcaption>{{ p.group_photo_caption }}</figcaption>{% endif %}
  </figure>
</section>
{% endif %}

{#- With a group photo, the photo replaces the atlas here (unless "also show
    the atlas" is ticked). The atlas always stays on the Research output page. -#}
{% set showAtlas = lab.isTrue(p.atlas_with_photo, false) if p.group_photo else lab.isTrue(p.show_atlas, true) %}
{% if showAtlas %}
<section class="wrap atlas-section{% if p.group_photo %} atlas-after-photo{% endif %}">
  {% include "atlas.njk" %}
</section>
{% endif %}

{% if p.themes and p.themes.length %}
<section class="themes">
  <div class="wrap">
    <h2 class="section-title">{{ p.themes_title }}</h2>
    <div class="card-grid-3">
      {%- for theme in p.themes %}
      <article class="theme-card">
        <div class="theme-card-bar"></div>
        <h3>{{ theme.title }}</h3>
        <p>{{ theme.body }}</p>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
{% endif %}
