---
layout: base.njk
navKey: research
permalink: /research/
---
{%- set p = lab.pages.research -%}
<section class="wrap research-head">
  {% if p.eyebrow %}<div class="eyebrow">{{ p.eyebrow }}</div>{% endif %}
  <h1 class="page-title">{{ p.title }}</h1>
  {% if p.intro %}<p class="lede">{{ p.intro }}</p>{% endif %}
  {% if lab.isTrue(p.show_atlas, true) %}{% include "atlas.njk" %}{% endif %}
</section>

<section class="wrap pubs">
  <h2 class="section-title">{{ p.publications_title }}</h2>
  {%- for year in lab.pubYears %}
  <div class="pub-year">
    <div class="pub-year-label">{{ year.year }}</div>
    <div class="pub-list">
      {%- for pub in year.items %}
      <article class="pub">
        <h3>{% if pub.link %}<a href="{{ pub.link }}" target="_blank" rel="noopener">{{ pub.title }}</a>{% else %}{{ pub.title }}{% endif %}</h3>
        {% if pub.authorsHtml %}<div class="pub-authors">{{ pub.authorsHtml | safe }}</div>{% endif %}
        {% if pub.journal or pub.open_access_url %}<div class="pub-journal">
          {%- if pub.journal %}<em>{{ pub.journal }}</em>{% endif %}
          {%- if pub.open_access_url %}{% if pub.journal %} · {% endif %}<a class="pub-oa" href="{{ pub.open_access_url }}" target="_blank" rel="noopener">Open access</a>{% endif -%}
        </div>{% endif %}
      </article>
      {%- endfor %}
    </div>
  </div>
  {%- endfor %}
  {%- if not lab.pubYears.length and p.empty_message %}
  <p class="pubs-empty">{{ p.empty_message }}</p>
  {%- endif %}
  {% if p.note or lab.pubsUpdated %}<div class="pubs-note">
    {%- if p.note %}{{ p.note }}{% endif %}
    {%- if p.note and lab.pubsUpdated %} · {% endif %}
    {%- if lab.pubsUpdated %}Updated automatically from <a href="https://openalex.org" target="_blank" rel="noopener">OpenAlex</a> · last change {{ lab.pubsUpdated }}{% endif -%}
  </div>{% endif %}
</section>