---
layout: base.njk
navKey: projects
permalink: /projects/
---
{%- set p = lab.pages.projects -%}
<section class="wrap projects-head">
  {% if p.eyebrow %}<div class="eyebrow">{{ p.eyebrow }}</div>{% endif %}
  <h1 class="page-title">{{ p.title }}</h1>
  {% if p.intro %}<p class="lede">{{ p.intro }}</p>{% endif %}
  <div>
    {%- for project in lab.projects %}
    <article class="project">
      <div>
        {% if project.status %}<div class="status">{{ project.status }}</div>{% endif %}
        {% if project.period %}<div class="project-period">{{ project.period }}</div>{% endif %}
      </div>
      <div>
        <h2>{% if project.url %}<a href="{{ project.url }}">{{ project.title }}</a>{% else %}{{ project.title }}{% endif %}</h2>
        <div class="project-body rich">{{ project.html | safe }}</div>
        {% if project.url %}<a class="project-more" href="{{ project.url }}">Read more on the KU Leuven research portal →</a>{% endif %}
      </div>
      <div class="project-meta">
        {% if project.lead %}<div>
          <div class="label">Lead</div>
          <div class="value-strong">{{ project.lead }}</div>
        </div>{% endif %}
        {% if project.funder %}<div>
          <div class="label">Funding</div>
          <div>{{ project.funder }}</div>
        </div>{% endif %}
      </div>
    </article>
    {%- endfor %}
  </div>
  {%- set ps = lab.projectSettings %}
  {% if ps.portal_link or lab.projectsUpdated %}
  <div class="projects-foot">
    {% if ps.portal_link %}<a href="{{ ps.portal_link }}">{{ ps.portal_link_text or "All our projects on the KU Leuven research portal" }} →</a>{% endif %}
    {% if lab.projectsUpdated %}<span class="pubs-note-inline">Updated automatically from <a href="https://www.researchportal.be">FRIS</a> · last change {{ lab.projectsUpdated }}</span>{% endif %}
  </div>
  {% endif %}
</section>

{% if p.cta_title %}
<section class="wrap cta-section">
  <div class="panel cta">
    <div>
      <h2>{{ p.cta_title }}</h2>
      {% if p.cta_text %}<p>{{ p.cta_text }}</p>{% endif %}
    </div>
    {% if p.cta_button %}<a class="btn btn-primary" href="/participate/">{{ p.cta_button }}</a>{% endif %}
  </div>
</section>
{% endif %}
